# Copy to .env (never commit .env) and replace every value.
DOMAIN=panel.example.ir
DATABASE_PASSWORD=change-me-long-random
# Each at least 32 random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=
# Keep this one forever: changing it makes every known patient look new.
NATIONAL_ID_PEPPER=
# The first admin account, created on the first start.
ADMIN_MOBILE=09120000000
ADMIN_PASSWORD=
ADMIN_NAME=مدیر سامانه
